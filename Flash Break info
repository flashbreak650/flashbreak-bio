<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Profile — Custom</title>
<style>
:root{
  --bg:#0f1720;
  --card:#0f1a24;
  --accent1:#6ee7b7;
  --accent2:#60a5fa;
  --muted:#98a2b3;
  --glass: rgba(255,255,255,0.03);
  --radius:14px;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}
*{box-sizing:border-box;}
body{
  margin:0;
  min-height:100vh;
  background: var(--bg);
  color:#e6eef6;
  display:flex;
  justify-content:center;
  padding:20px;
  font-size:15px;
  transition: background 0.5s, color 0.5s;
}
.container{
  max-width:920px;
  display:grid;
  grid-template-columns: 320px 1fr;
  gap:20px;
}
.profile-card{
  background:var(--card);
  border-radius:var(--radius);
  padding:22px;
  box-shadow:0 6px 24px rgba(0,0,0,0.5);
  transition: background 0.5s, color 0.5s;
}
.avatar-wrap{
  display:flex; align-items:center; gap:16px;
}
.avatar{
  width:120px; height:120px; border-radius:999px;
  overflow:hidden; flex-shrink:0; border:4px solid rgba(255,255,255,0.06);
  display:flex; justify-content:center; align-items:center;
  background: linear-gradient(135deg,var(--accent1),var(--accent2));
}
.avatar img{width:100%;height:100%;object-fit:cover;}
.name-block{flex:1;}
h1{
  margin:0 0 6px 0; font-size:22px; letter-spacing:0.2px;
  cursor:pointer;
  transition: transform 0.3s;
}
h1:hover{transform:scale(1.05);}
.subtitle{color:var(--muted); font-size:13px;}
.info-card{
  margin-top:18px; background:var(--card);
  padding:14px; border-radius:12px; color:var(--muted);
  transition: background 0.5s, color 0.5s;
}
.info-row{display:flex; justify-content:space-between; padding:10px 6px; border-bottom:1px dashed rgba(255,255,255,0.02);}
.info-row:last-child{border-bottom:0;}
.info-label{ font-size:13px;}
.info-value{ font-weight:700; color:#e6eef6; transition: color 0.5s; }
.panel{
  background:var(--card);
  border-radius:var(--radius);
  padding:18px;
  min-height:240px;
  box-shadow:0 6px 24px rgba(0,0,0,0.5);
  transition: background 0.5s, color 0.5s;
}
.panel h2{margin:0 0 8px 0; font-size:18px;}
.field{display:flex;flex-direction:column; gap:6px; margin-bottom:12px;}
.field label{font-size:13px; color:var(--muted);}
.field input, .field textarea{
  padding:10px; border-radius:10px; border:1px solid rgba(255,255,255,0.03);
  background:var(--glass); color:#e6eef6; outline:none; font-size:14px;
}
textarea{min-height:100px; resize:vertical;}
.controls{display:flex;gap:10px; flex-wrap:wrap; margin-top:8px;}
.btn{padding:8px 14px; border-radius:10px; border:none; cursor:pointer; font-weight:600;}
.btn.secondary{background:transparent; color:var(--muted); border:1px solid rgba(255,255,255,0.03);}
.muted-note{color:var(--muted); font-size:13px;}
footer{margin-top:16px; font-size:13px; color:var(--muted);}
@media(max-width:880px){.container{grid-template-columns:1fr;} .avatar{width:96px;height:96px;} .profile-card{order:2;} .panel{order:1;}}
</style>
</head>
<body>
<div class="container">
<div class="profile-card" id="profileCard">
  <div class="avatar-wrap">
    <div class="avatar"><img id="avatarImg" src=""></div>
    <div class="name-block">
      <h1 id="displayName">Developer Flash Break</h1>
      <div class="subtitle" id="displaySubtitle"></div>
    </div>
  </div>

  <div class="info-card">
    <div style="font-weight:700; margin-bottom:8px">Personal Information</div>
    <div class="info-row"><div class="info-label">Role</div><div class="info-value" id="infoRole"></div></div>
    <div class="info-row"><div class="info-label">Location</div><div class="info-value" id="infoLocation"></div></div>
    <div class="info-row"><div class="info-label">Birth</div><div class="info-value" id="infoBirth"></div></div>
    <div class="info-row"><div class="info-label">Blood Group</div><div class="info-value" id="infoBlood"></div></div>
    <div class="info-row"><div class="info-label">Telegram</div><div class="info-value" id="infoTelegram"></div></div>
    <div class="info-row"><div class="info-label">Website</div><div class="info-value" id="infoWebsite"></div></div>
  </div>

  <div style="margin-top:20px; text-align:center;">
    <button id="adminBtn" class="btn secondary" style="display:none">Admin Login</button>
  </div>

  <footer>Built with HTML/CSS/JS • Flash Break</footer>
</div>

<div class="panel" id="editorPanel" style="display:none">
  <h2>Profile Editor</h2>
  <div class="row">
    <div class="field"><label>Name</label><input type="text" id="inputName"></div>
    <div class="field"><label>Role</label><input type="text" id="inputRole"></div>
  </div>
  <div class="row">
    <div class="field"><label>Location</label><input type="text" id="inputLocation"></div>
    <div class="field"><label>Birth</label><input type="date" id="inputBirth"></div>
  </div>
  <div class="field"><label>Blood Group</label><input type="text" id="inputBlood"></div>
  <div class="field"><label>Telegram</label><input type="text" id="inputTelegram"></div>
  <div class="field"><label>Website</label><input type="text" id="inputWebsite"></div>
  <div class="controls">
    <button class="btn" id="saveBtn">Save Changes</button>
    <button class="btn secondary" id="cancelBtn">Close Editor</button>
  </div>
  <div class="muted-note" id="status"></div>
</div>
</div>

<script>
const LS_KEY = 'profile_v1';
const ADMIN_PASS = 'flashbreak556677';
const editorPanel = document.getElementById('editorPanel');
const displayName = document.getElementById('displayName');
let tapCount=0;
let profile={};

async function loadProfile(){
  try{
    const res = await fetch('profile.json');
    profile = await res.json();
  }catch(e){console.warn('JSON load failed',e);}
  renderProfile();
}
function renderProfile(){
  document.getElementById('displayName').textContent = profile.name || '';
  document.getElementById('displaySubtitle').textContent = profile.subtitle || '';
  document.getElementById('infoRole').textContent = profile.role || '';
  document.getElementById('infoLocation').textContent = profile.location || '';
  document.getElementById('infoBirth').textContent = profile.birth || '';
  document.getElementById('infoBlood').textContent = profile.blood || '';
  document.getElementById('infoTelegram').textContent = profile.extraInfo.telegram || '';
  document.getElementById('infoWebsite').textContent = profile.extraInfo.website || '';
  if(profile.avatarDataUrl){
    document.getElementById('avatarImg').src = profile.avatarDataUrl;
  }
}

// Admin login after 10 taps
displayName.addEventListener('click',()=>{
  tapCount++;
  if(tapCount>=10){
    tapCount=0;
    const pw=prompt('Enter Admin Password:');
    if(pw===ADMIN_PASS){ editorPanel.style.display='block'; }
    else alert('Wrong password!');
  }
});

document.getElementById('saveBtn').addEventListener('click',()=>{
  profile.name = document.getElementById('inputName').value;
  profile.role = document.getElementById('inputRole').value;
  profile.location = document.getElementById('inputLocation').value;
  profile.birth = document.getElementById('inputBirth').value;
  profile.blood = document.getElementById('inputBlood').value;
  profile.extraInfo.telegram = document.getElementById('inputTelegram').value;
  profile.extraInfo.website = document.getElementById('inputWebsite').value;
  localStorage.setItem(LS_KEY, JSON.stringify(profile));
  renderProfile();
  editorPanel.style.display='none';
});

document.getElementById('cancelBtn').addEventListener('click',()=> editorPanel.style.display='none');

loadProfile();
</script>
</body>
</html>
